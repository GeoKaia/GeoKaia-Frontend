# URL del backend (solo servidor). Next reenvia /api/* a esta direccion (rewrites).
# Por defecto: el backend deployado en Render. Local: http://localhost:4000
BACKEND_URL=https://geokaia-backend.onrender.com

# Pasarela de pago SIMULADA del plan Premium (opcional). Links de pago https de Banpro / Pagadito que se abren
# en otra pestaña al elegir el medio de pago. Si quedan vacíos, el flujo muestra una redirección simulada.
# En ambos casos la demo sigue con "Ya pagué — continuar con la demo".
NEXT_PUBLIC_PAGO_BANPRO_URL=
NEXT_PUBLIC_PAGO_PAGADITO_URL=
# Opcional y solo para desarrollo: si se define, el navegador llama directo a esa URL en vez de usar /api.
# NEXT_PUBLIC_API_URL=http://localhost:4000
