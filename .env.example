# URL base de la API del backend. Opcional: si no se define, la app apunta al
# backend deployado en Render. Usá http://localhost:4000 para apuntar a un
# backend corriendo en local.
NEXT_PUBLIC_API_URL=https://geokaia-backend.onrender.com

# Pasarela de pago SIMULADA del plan Premium (opcional). Links de pago https de Banpro / Pagadito que se abren
# en otra pestaña al elegir el medio de pago. Si quedan vacíos, el flujo muestra una redirección simulada.
# En ambos casos la demo sigue con "Ya pagué — continuar con la demo".
NEXT_PUBLIC_PAGO_BANPRO_URL=
NEXT_PUBLIC_PAGO_PAGADITO_URL=

# Opcional. Con "true" vuelve a aparecer el botón "Editar" del admin sobre lugares ajenos (hay que activar también
# ADMIN_EDICION_LUGARES=true en el backend). Por defecto está oculto: el equipo deja comentarios al negocio.
NEXT_PUBLIC_ADMIN_EDICION=false
